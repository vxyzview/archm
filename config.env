# archm build settings: sourced by build.sh and scripts/customize.sh (plain shell syntax).

# Installed on top of the Arch Linux ARM base. Names missing from the repos are skipped,
# so one list works for both arm64 (aarch64) and arm (armv7).
EXTRA_PKGS="nano sudo curl wget git openssh htop fastfetch bash-completion"

# Packages in the stock tarball that are dead weight inside proot (the Android kernel is
# what actually runs): kernel, headers, firmware, U-Boot, initramfs tooling.
# Extended regex, matched against whole package names.
REMOVE_REGEX='^(linux-(aarch64|armv[0-9]+)(-headers)?|linux-firmware(-.*)?|uboot-.*|mkinitcpio(-.*)?)$'

# 1 = do not install docs or non-English translations (locales, translated man pages), and drop
# the generated hwdb.bin: far fewer files, so installs, upgrades and xyzterm backups get faster.
# English man pages are kept. Set 0 for a stock layout.
SLIM=1

LOCALE=en_US.UTF-8
TIMEZONE=UTC
